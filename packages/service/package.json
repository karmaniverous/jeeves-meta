{
  "author": "Jason Williscroft",
  "bin": {
    "jeeves-meta": "./dist/cli/jeeves-meta/index.js"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-meta/issues"
  },
  "dependencies": {
    "@karmaniverous/jeeves": "0.6.0-8",
    "@karmaniverous/jeeves-meta-core": "^0.2.2",
    "commander": "^15",
    "croner": "^10",
    "fastify": "^5.12",
    "handlebars": "^4.7.9",
    "package-directory": "^8.2.0",
    "pino": "^10",
    "zod": "^4.6"
  },
  "description": "Fastify HTTP service for the Jeeves Meta synthesis engine",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.0",
    "rollup": "^4.63.5",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves-meta#readme",
  "keywords": [
    "synthesis",
    "knowledge",
    "meta",
    "jeeves",
    "service",
    "fastify",
    "typescript"
  ],
  "license": "BSD-3-Clause",
  "name": "@karmaniverous/jeeves-meta",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-meta v${version}",
      "requireBranch": "main",
      "tagName": "service/${version}"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:bump": [
        "npm install --package-lock-only --ignore-scripts",
        "git -C ../.. add package-lock.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/service/${version}",
        "git push -u origin release/service/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/service",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-meta.git"
  },
  "scripts": {
    "build": "rimraf dist && cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin \"@rollup/plugin-typescript={outputToFilesystem:true,paths:{}}\"",
    "changelog": "git-cliff -o CHANGELOG.md",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "version": "0.18.0-0"
}

@startuml plugin-lifecycle

skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam defaultFontSize 12

title jeeves-meta-openclaw — Plugin Lifecycle

participant "OpenClaw Gateway" as GW
participant "Plugin\nregister()" as Plugin
participant "@karmaniverous/jeeves\ncore" as Core
participant "jeeves-meta\nservice" as Service

== Startup (no config required) ==

GW -> Plugin: register(api)
activate Plugin
Plugin -> Plugin: warn once if configRoot unset
Plugin -> GW: registerTool(meta_* x 12)
deactivate Plugin

== HTTP Tool Invocation ==

GW -> Plugin: meta_trigger({ path })
Plugin -> Service: POST /synthesize
Service --> Plugin: { status: "accepted" }
Plugin --> GW: ToolResult

== meta_service Invocation ==

GW -> Plugin: meta_service({ action })
alt configRoot resolved (plugin config or JEEVES_CONFIG_ROOT)
  Plugin -> Core: init({ workspacePath, configRoot }) (first use only)
  Plugin -> Core: service manager action
  Plugin --> GW: ToolResult
else configRoot unset
  Plugin --> GW: error: "configRoot not configured — set it in plugin config ... or via JEEVES_CONFIG_ROOT"
end

@enduml

{
  "dependencies": {
    "@karmaniverous/jeeves": "0.11.0",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.2",
    "rollup": "^4.68.3",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "zod-openapi": "^6.0.2"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "name": "@karmaniverous/jeeves-meta-core",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-meta-core v${version}",
      "requireBranch": "main",
      "tagName": "core/${version}"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag core/${version} --unreleased --strip header"
    },
    "hooks": {
      "after:bump": [
        "npm install --package-lock-only --ignore-scripts",
        "npm run openapi",
        "npm run build",
        "git -C ../.. add package-lock.json",
        "git add openapi.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/core/${version}",
        "git push -u origin release/core/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff --tag core/${version} -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "scripts": {
    "build": "rimraf dist && cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "openapi": "tsx scripts/write-openapi.ts",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.4.0-1"
}

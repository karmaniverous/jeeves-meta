{
  "name": "jeeves-meta-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/sdk && npm run build --workspace=packages/service && npm run build --workspace=packages/openclaw",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=packages/core && npm run typecheck --workspace=packages/sdk && npm run typecheck --workspace=packages/service && npm run typecheck --workspace=packages/openclaw",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "git-cliff": "^2.14.2",
    "jiti": "^2.7.0",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "allowScripts": {
    "fsevents": true,
    "lefthook": true
  }
}
